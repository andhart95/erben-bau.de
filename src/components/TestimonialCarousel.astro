---
// A11y-konformes Karussell, vanilla. Cross-Fade statt translateX.
// Auto-Advance opt-in; Pause on hover/focus + reduced-motion + tab-hidden.
const testimonials = [
  '“Mit dem Team von Erben Services hatten wir endlich eine Instanz, die zwischen Bauherrn und Gewerken alles zusammenhält. Transparent, zuverlässig und absolut professionell.”',
  '"Das Erben Team hat Probleme erkannt, bevor sie überhaupt entstanden sind. So blieb die Baustelle stressfrei und das Ergebnis war erstklassig."',
  '“Das Erben Team hat uns die komplette Koordination abgenommen. Alles lief reibungslos, und wir konnten uns voll auf das Projekt konzentrieren..”',
  '“Dank dem Team von Erben können wir uns wieder voll auf unser Handwerk konzentrieren. Den ganzen administrativen Aufwand übernehmen sie professionell und effizient.”',
  '"Mit der Firma Erben als Partner haben wir unsere gesamten internen und externen Abläufe modernisiert und automatisiert, was uns zusätzliche Kapazitäten für neue Projekt geschaffen hat. Das hätten wir alleine nie erreicht."',
];
const AUTOPLAY = true;
const INTERVAL = 7000;
---

<section
  class="bg-beige"
  aria-roledescription="carousel"
  aria-label="Kundenstimmen"
  id="eb-testimonials"
  data-autoplay={AUTOPLAY ? 'true' : 'false'}
  data-interval={INTERVAL}
>
  <div class="mx-auto max-w-[980px] px-6 py-[clamp(4rem,2.5rem+6vw,9rem)] text-center md:px-10">
    <p class="eyebrow eyebrow--rule mb-4 justify-center text-muted-strong" data-reveal>Kunden vertrauen auf Erben Bau</p>
    <h2 class="mb-12 text-[clamp(2.5rem,1.4rem+4vw,4.8rem)] font-medium tracking-[-0.02em] text-ink" data-reveal>
      Rezensionen
    </h2>

    <div class="relative" data-reveal>
      <span
        aria-hidden="true"
        class="pointer-events-none absolute left-1/2 top-[-0.35em] z-0 -translate-x-1/2 select-none font-medium leading-none text-brand/10"
        style="font-size: clamp(7rem, 4rem + 14vw, 13rem);">„</span>

      <div id="eb-stage" class="relative z-10 mx-auto min-h-[clamp(9rem,7rem+8vw,12rem)] max-w-[62ch]">
        {
          testimonials.map((t, i) => (
            <p
              class="eb-slide absolute inset-0 flex items-center justify-center px-1 text-[clamp(1.2rem,1rem+0.9vw,1.6rem)] leading-relaxed text-ink/80"
              role="group"
              aria-roledescription="Rezension"
              aria-label={`${i + 1} von ${testimonials.length}`}
              data-slide={i}
              hidden={i !== 0}
            >
              <span class="text-balance">{t}</span>
            </p>
          ))
        }
      </div>

      <div class="mt-10 flex items-center justify-center gap-5">
        <button
          id="eb-prev"
          type="button"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-ink/25 text-ink transition-[color,background-color,border-color,transform] duration-200 ease-out hover:border-brand hover:bg-brand hover:text-white active:scale-95"
          aria-label="Vorherige Rezension"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"
            ><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg
          >
        </button>
        <div id="eb-dots" class="flex items-center gap-2"></div>
        <button
          id="eb-next"
          type="button"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-ink/25 text-ink transition-[color,background-color,border-color,transform] duration-200 ease-out hover:border-brand hover:bg-brand hover:text-white active:scale-95"
          aria-label="Nächste Rezension"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"
            ><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg
          >
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .eb-slide {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.45s var(--ease-out-expo), transform 0.45s var(--ease-out-expo);
  }
  .eb-slide.is-active { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .eb-slide { transition: none; transform: none; }
  }
</style>

<script>
  const root = document.getElementById('eb-testimonials');
  const stage = document.getElementById('eb-stage');
  const prev = document.getElementById('eb-prev');
  const next = document.getElementById('eb-next');
  const dotsWrap = document.getElementById('eb-dots');

  if (root && stage && dotsWrap) {
    const slides = [...stage.querySelectorAll<HTMLElement>('.eb-slide')];
    const count = slides.length;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let idx = 0;
    let timer: number | undefined;

    const dots: HTMLButtonElement[] = [];
    for (let i = 0; i < count; i++) {
      const d = document.createElement('button');
      d.type = 'button';
      // 24px Touch-Target, sichtbarer Punkt als inneres span
      d.className = 'eb-dot flex h-6 w-6 items-center justify-center';
      d.setAttribute('aria-label', `Gehe zu Rezension ${i + 1}`);
      d.innerHTML = '<span class="eb-dot-mark block h-2 w-2 rounded-full bg-ink/25 transition-[width,background-color] duration-200 ease-out"></span>';
      d.addEventListener('click', () => { go(i); restart(); });
      dotsWrap.appendChild(d);
      dots.push(d);
    }

    const go = (i: number) => {
      idx = (i + count) % count;
      slides.forEach((s, si) => {
        const active = si === idx;
        s.hidden = false;
        s.classList.toggle('is-active', active);
        if (active) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((d, di) => {
        const mark = d.querySelector('.eb-dot-mark') as HTMLElement | null;
        const active = di === idx;
        if (mark) {
          mark.classList.toggle('w-6', active);
          mark.classList.toggle('bg-brand', active);
          mark.classList.toggle('w-2', !active);
          mark.classList.toggle('bg-ink/25', !active);
        }
        if (active) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
      });
    };

    const wantsAutoplay = root.dataset.autoplay === 'true' && !reduce;
    const interval = Number(root.dataset.interval) || 7000;
    const stop = () => { if (timer) window.clearInterval(timer); timer = undefined; };
    const start = () => { if (!wantsAutoplay || timer) return; timer = window.setInterval(() => go(idx + 1), interval); };
    const restart = () => { stop(); start(); };

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else start(); });

    prev?.addEventListener('click', () => { go(idx - 1); restart(); });
    next?.addEventListener('click', () => { go(idx + 1); restart(); });
    root.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (k === 'ArrowLeft') { go(idx - 1); restart(); }
      if (k === 'ArrowRight') { go(idx + 1); restart(); }
    });

    go(0);
    start();
  }
</script>
