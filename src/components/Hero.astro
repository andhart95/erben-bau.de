---
import Button from './Button.astro';

const CAL =
  'https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ3mSeSUNX1Y0Ddx15WUzG8q0enFHNT9Y9nkOn6Ooz78oN4aIrP346JlV6vsufMnr3_vrbd6NV0z';
---

<section class="relative isolate flex min-h-[88vh] items-end overflow-hidden bg-ink">
  <img
    src="/img/hero.webp"
    alt="Renoviertes Haus von innen mit Treppe und Holzboden"
    width="2400"
    height="1351"
    fetchpriority="high"
    loading="eager"
    decoding="async"
    data-hero-img
    class="hero-img absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <div
    class="absolute inset-0 -z-10"
    style="background: linear-gradient(rgba(0,0,0,0.28), rgba(20,18,18,0.72));"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto w-full max-w-[1456px] px-6 pb-20 pt-32 md:px-10 md:pb-28">
    <div class="hero-reveal max-w-2xl text-white" style="text-shadow: 0 1px 4px rgba(0,0,0,0.45);">
      <p class="eyebrow reveal-fade mb-4 text-white" style="--fade-delay:0ms">Erben Baukoordination</p>
      <h1 class="text-[clamp(2.5rem,1.2rem+5vw,4.8rem)] font-medium leading-[1.04] tracking-[-0.02em]">
        <span class="reveal-line" style="--line-delay:90ms"><span>Alle Dienstleister</span></span>
        <span class="reveal-line" style="--line-delay:180ms"><span>aus einer Hand</span></span>
      </h1>
      <p class="reveal-fade mt-6 text-xl leading-relaxed text-white/90" style="--fade-delay:320ms">
        Ein Ansprechpartner für alle Gewerke.<br />Schnell, digital und persönlich vor Ort.
      </p>
      <div class="reveal-fade mt-8 flex flex-wrap gap-4" style="--fade-delay:430ms">
        <Button href="/kontakt" variant="primary">Kontakt</Button>
        <Button href={CAL} target="_blank" variant="outline-light">
          Beratungstermin
          <span class="btn-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
              ><path d="M3 8h9M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg
            >
          </span>
        </Button>
      </div>
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector('.hero-reveal');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fire = () => hero?.classList.add('hero-in');
  if (reduce) fire();
  else requestAnimationFrame(() => requestAnimationFrame(fire));

  // Dezenter Hero-Parallax (nur Desktop + motion)
  const img = document.querySelector('[data-hero-img]') as HTMLElement | null;
  const section = img?.closest('section') as HTMLElement | null;
  const mq = window.matchMedia('(prefers-reduced-motion: no-preference) and (min-width: 768px)');
  if (img && section && mq.matches) {
    const MAX = 0.06;
    let ticking = false;
    const update = () => {
      const rect = section.getBoundingClientRect();
      const h = section.offsetHeight || 1;
      const progress = Math.min(Math.max(-rect.top / h, 0), 1);
      img.style.transform = `translate3d(0, ${(progress * MAX * h).toFixed(1)}px, 0) scale(1.06)`;
      ticking = false;
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>
